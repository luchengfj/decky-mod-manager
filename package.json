{
  "name": "decky-mod-manager",
  "version": "0.1.0",
  "private": true,
  "description": "MOD manager for Steam Deck Game Mode: install, enable/disable, uninstall and roll back game mods from the Quick Access Menu",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@decky/api": "1.1.3",
    "@decky/ui": "4.16.5",
    "@decky/rollup": "1.0.2",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-import-assets": "^1.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
